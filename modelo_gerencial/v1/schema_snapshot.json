            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "responsavel_papel": {
          "type": "string",
          "minLength": 1
        },
        "evidencias_documentais_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "fonte_evento_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "etapa": {
          "type": "string",
          "minLength": 1
        },
        "plano_inspecao_id": {
          "$ref": "#/$defs/id"
        },
        "situacao": {
          "enum": [
            "aguardando_analise",
            "liberado_por_ato",
            "bloqueado_por_ato"
          ]
        },
        "ato_formal_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
