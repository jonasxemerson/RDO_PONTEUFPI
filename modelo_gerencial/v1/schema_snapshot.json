            "especificacao",
            "rdo",
            "ensaio",
            "liberacao",
            "medicao",
            "notificacao",
            "outro"
          ]
        },
        "data_documento": {
          "$ref": "#/$defs/date"
        },
        "versao": {
          "type": "string",
          "minLength": 1
        },
        "acesso": {
          "enum": [
            "publico",
            "interno",
            "restrito"
          ]
        },
        "url_ou_referencia": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "classe",
        "data_documento",
        "versao",
        "acesso",
        "url_ou_referencia",
        "sha256"
      ],
      "additionalProperties": false
    },
    "planos_inspecao": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "servico": {
          "type": "string",
          "minLength": 1
        },
        "etapa": {
          "type": "string",
          "minLength": 1
        },
        "referencia_projeto_id": {
          "$ref": "#/$defs/id"
        },
        "criterio_aprovacao": {
          "type": "string",
          "minLength": 1
        },
        "ensaios_exigidos": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "autoridade_liberadora": {
          "type": "string",
          "minLength": 1
        },
        "data_aprovacao": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "servico",
        "etapa",
        "referencia_projeto_id",
        "criterio_aprovacao",
        "ensaios_exigidos",
        "autoridade_liberadora",
        "data_aprovacao"
      ],
      "additionalProperties": false
    },
    "ensaios": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "data_abertura": {
          "$ref": "#/$defs/date"
        },
        "frente_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(E0[1-9]|GERAL|FAB|CONTRATO)$"
        },
        "elemento_id": {
