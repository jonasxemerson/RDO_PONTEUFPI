            },
            {
              "type": "null"
            }
          ]
        },
        "tipo_ensaio": {
          "type": "string",
          "minLength": 1
        },
        "plano_inspecao_id": {
          "$ref": "#/$defs/id"
        },
        "laboratorio": {
          "type": "string",
          "minLength": 1
        },
        "data_ensaio": {
