{
  "type": "object",
  "properties": {
    "versao_schema": {
      "const": "1.0.0"
    },
    "id_empreendimento": {
      "const": "ponte-ufpi"
    },
    "escopo": {
      "enum": [
        "interno",
        "publico"
      ]
    },
    "data_referencia": {
      "$ref": "#/$defs/date"
    },
    "origem": {
      "$ref": "#/$defs/origem"
    },
    "base_quantitativa": {
      "$ref": "#/$defs/quant"
    },
    "eixos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/axis"
      },
      "minItems": 9,
      "maxItems": 9
    },
    "elementos_individualizados": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/element"
      }
    },
    "referencias_eventos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event_ref"
      }
    },
    "gestao_contratual": {
      "$ref": "#/$defs/contract"
    },
    "controles_formais": {
      "$ref": "#/$defs/formal_controls"
    },
    "alertas_derivados": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/alert"
      }
    },
    "regras": {
      "$ref": "#/$defs/regras"
    },
    "diagnostico": {
      "$ref": "#/$defs/diagnostic"
    }
  },
  "required": [
    "versao_schema",
    "id_empreendimento",
    "escopo",
    "data_referencia",
    "origem",
    "base_quantitativa",
    "eixos",
    "elementos_individualizados",
    "referencias_eventos",
    "gestao_contratual",
    "controles_formais",
    "alertas_derivados",
    "regras"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jonasxemerson/RDO_PONTEUFPI/modelo_gerencial/v1/schema_snapshot.json",
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "filesha": {
      "type": "object",
      "properties": {
        "arquivo": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "arquivo",
        "sha256"
      ],
      "additionalProperties": false
    },
    "origem": {
      "type": "object",
      "properties": {
        "integracao": {
          "const": "projecao_nao_destrutiva"
        },
        "regra_relato": {
          "const": "homologado_responsavel_e_confiavel_como_registro_de_campo"
        },
        "arquivos_sha256": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/filesha"
          },
          "minItems": 3
        }
      },
      "required": [
        "integracao",
        "regra_relato",
        "arquivos_sha256"
      ],
      "additionalProperties": false
    },
    "q_stat": {
      "type": "object",
      "properties": {
        "situacao": {
          "enum": [
            "nao_avaliado",
            "em_analise",
            "conforme",
            "nao_conforme",
            "nao_aplicavel"
          ]
        },
        "quantidade_aceita": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "documento_liberacao_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "situacao",
        "quantidade_aceita",
        "documento_liberacao_id"
      ],
      "additionalProperties": false
    },
    "hp_stat": {
      "type": "object",
      "properties": {
        "situacao": {
          "enum": [
            "nao_configurado",
            "aguardando_analise",
            "liberado_por_ato",
            "bloqueado_por_ato"
          ]
        },
        "ato_liberacao_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "situacao",
        "ato_liberacao_id"
      ],
      "additionalProperties": false
    },
    "med_stat": {
      "type": "object",
      "properties": {
        "situacao": {
          "enum": [
            "nao_avaliada",
            "em_conferencia",
            "apta_por_criterio_contratual",
            "retida_por_ato",
            "medida"
          ]
        },
        "quantidade_apta": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "referencia_bm_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "situacao",
        "quantidade_apta",
        "referencia_bm_id"
      ],
      "additionalProperties": false
    },
    "axis": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^E0[1-9]$"
        },
        "estacas_previstas": {
          "type": "integer",
          "minimum": 1
        },
        "estacas_execucao_registrada": {
          "type": "integer",
          "minimum": 0
        },
        "estacas_concretagem_identificada": {
          "type": "integer",
          "minimum": 0
        },
        "execucao_etapa": {
          "type": "string",
          "minLength": 1
        },
        "origem_execucao": {
          "enum": [
            "base_historica",
            "campo_homologado"
          ]
        },
        "data_ultimo_snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "evento_snapshot_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidencia_do_eixo_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "excedente_execucao_sobre_projeto": {
          "type": "integer",
          "minimum": 0
        },
        "status_geom": {
          "const": "nao_verificado_individualmente"
        },
        "controle_tecnologico": {
          "$ref": "#/$defs/q_stat"
        },
        "hold_point": {
          "$ref": "#/$defs/hp_stat"
        },
        "medicao": {
          "$ref": "#/$defs/med_stat"
        }
      },
      "required": [
        "id",
        "estacas_previstas",
        "estacas_execucao_registrada",
        "estacas_concretagem_identificada",
        "execucao_etapa",
        "origem_execucao",
        "data_ultimo_snapshot",
        "evento_snapshot_id",
        "evidencia_do_eixo_ids",
        "excedente_execucao_sobre_projeto",
        "status_geom",
        "controle_tecnologico",
        "hold_point",
        "medicao"
      ],
      "additionalProperties": false
    },
    "element": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "eixo_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^E0[1-9]$"
        },
        "tipo": {
          "type": "string",
          "minLength": 1
        },
        "identificacao": {
          "const": "identificado_em_relato_sem_validacao_geometrica"
        },
        "etapa_relato": {
          "type": "string",
          "minLength": 1
        },
        "execucao_integral_comprovada": {
          "type": "boolean"
        },
        "evento_origem_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1
        },
        "liberacao_tecnica": {
          "enum": [
            "nao_avaliada",
            "em_analise",
            "liberada_por_ato",
            "bloqueada_por_ato"
          ]
        }
      },
      "required": [
        "id",
        "eixo_id",
        "tipo",
        "identificacao",
        "etapa_relato",
        "execucao_integral_comprovada",
        "evento_origem_ids",
        "liberacao_tecnica"
      ],
      "additionalProperties": false
    },
    "event_ref": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "arquivo_origem": {
          "type": "string",
          "minLength": 1,
          "pattern": "^data/observacoes-\\d{4}-\\d{2}\\.json$"
        },
        "data": {
          "$ref": "#/$defs/date"
        },
        "eixo_ou_frente": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(E0[1-9]|GERAL|FAB)$"
        },
        "servico": {
          "type": "string",
          "minLength": 1
        },
        "estado_relato": {
          "type": "string",
          "minLength": 1
        },
        "validacao_relato": {
          "enum": [
            "homologado_responsavel",
            "validado_campo",
            "pendente_esclarecimento",
            "inferido",
            "relato_nao_homologado"
          ]
        },
        "revisao_classificacao_pendente": {
          "type": "boolean"
        },
        "elementos_identificados_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "required": [
        "id",
        "arquivo_origem",
        "data",
        "eixo_ou_frente",
        "servico",
        "estado_relato",
        "validacao_relato",
        "revisao_classificacao_pendente",
        "elementos_identificados_ids"
      ],
      "additionalProperties": false
    },
    "numeric": {
      "type": "integer",
      "minimum": 0
    },
    "quant": {
      "type": "object",
      "properties": {
        "estacas_previstas": {
          "$ref": "#/$defs/numeric"
        },
        "estacas_execucao_registrada": {
          "$ref": "#/$defs/numeric"
        },
        "estacas_concretagem_identificada": {
          "$ref": "#/$defs/numeric"
        },
        "execucao_etapas_mistas": {
          "type": "boolean"
        },
        "blocos_concluidos_registrados": {
          "$ref": "#/$defs/numeric"
        },
        "pilares_integralmente_concretados_registrados": {
          "$ref": "#/$defs/numeric"
        },
        "longarinas_concretadas_registradas": {
          "anyOf": [
            {
              "$ref": "#/$defs/numeric"
            },
            {
              "type": "null"
            }
          ]
        },
        "prelajes_incrementais_novembro": {
          "$ref": "#/$defs/numeric"
        },
        "prelajes_estoque_total": {
          "anyOf": [
            {
              "$ref": "#/$defs/numeric"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "estacas_previstas",
        "estacas_execucao_registrada",
        "estacas_concretagem_identificada",
        "execucao_etapas_mistas",
        "blocos_concluidos_registrados",
        "pilares_integralmente_concretados_registrados",
        "longarinas_concretadas_registradas",
        "prelajes_incrementais_novembro",
        "prelajes_estoque_total"
      ],
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "properties": {
        "linha_base_cronograma_aprovada_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "idp_spi": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "valor_agregado_ev": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "valor_planejado_pv": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "idp_situacao": {
          "enum": [
            "nao_calculavel_sem_linha_base_e_pesos",
            "calculado_sobre_linha_base_aprovada"
          ]
        },
        "caminho_critico_documentado": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "ritmo_semanal_meta": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "medicao_financeira_vigente": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "alerta_90pct_quantidade_contratual": {
          "enum": [
            "nao_calculavel_sem_itens_contratuais_comparaveis",
            "avaliado_por_item_contratual"
          ]
        }
      },
      "required": [
        "linha_base_cronograma_aprovada_id",
        "idp_spi",
        "valor_agregado_ev",
        "valor_planejado_pv",
        "idp_situacao",
        "caminho_critico_documentado",
        "ritmo_semanal_meta",
        "medicao_financeira_vigente",
        "alerta_90pct_quantidade_contratual"
      ],
      "additionalProperties": false
    },
    "alert": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "tipo": {
          "const": "diferenca_quantitativa_executado_previsto"
        },
        "eixo_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^E0[1-9]$"
        },
        "gravidade": {
          "const": "requer_compatibilizacao"
        },
        "automatico": {
          "type": "boolean"
        },
        "rnc_formal": {
          "type": "boolean"
        },
        "referencia_evento_id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "id",
        "tipo",
        "eixo_id",
        "gravidade",
        "automatico",
        "rnc_formal",
        "referencia_evento_id"
      ],
      "additionalProperties": false
    },
    "documentos": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "classe": {
          "enum": [
