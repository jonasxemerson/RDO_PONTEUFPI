              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "situacao": {
          "enum": [
            "informado",
            "em_validacao",
            "aprovado_por_responsavel",
            "reprovado_por_responsavel",
            "inconclusivo"
          ]
        }
      },
      "required": [
        "id",
        "data_abertura",
        "frente_id",
        "elemento_id",
        "responsavel_papel",
        "evidencias_documentais_ids",
        "fonte_evento_id",
        "tipo_ensaio",
        "plano_inspecao_id",
        "laboratorio",
        "data_ensaio",
        "resultado",
        "unidade",
        "criterio_aprovacao_documento_id",
