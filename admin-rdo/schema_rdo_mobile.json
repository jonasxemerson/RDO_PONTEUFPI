{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://certare.local/rdo-mobile/v1.0.0",
  "title": "RDO móvel privado — CERTARE/UFPI",
  "description": "Relatos de campo e fotos para revisão, sem aceite tecnológico ou medição.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "project",
    "privacy",
    "status",
    "validation",
    "created_at",
    "created_by",
    "local_reference",
    "source",
    "model_link",
    "header",
    "records",
    "photos"
  ],
  "properties": {
    "schema_version": {
      "const": "rdo-mobile/1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^rdo-[0-9]{4}-[0-9]{2}-[0-9]{2}-[A-Za-z0-9-]+$"
    },
    "project": {
      "const": "ponte-ufpi"
    },
    "privacy": {
      "const": "privado"
    },
    "status": {
      "const": "submetido_para_revisao"
    },
    "validation": {
      "const": "proposto_revisao"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "const": "jonasxemerson"
    },
    "local_reference": {
      "type": "string",
      "minLength": 8
    },
    "source": {
      "const": "interface_administrativa_rdo_movel"
    },
    "model_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_schema",
        "project_id",
        "approval_required"
      ],
      "properties": {
        "model_schema": {
          "const": "1.0.0"
        },
        "project_id": {
          "const": "ponte-ufpi"
        },
        "approval_required": {
          "const": true
        }
      }
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "shift",
        "type",
        "weather",
        "workers",
        "equipment",
        "notes"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "shift": {
          "type": "string",
          "enum": [
            "manha",
            "tarde",
            "noite",
            "integral"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "vistoria",
            "rdo",
            "ocorrencia"
          ]
        },
        "weather": {
          "type": "string",
          "enum": [
            "nao_informado",
            "sem_chuva",
            "chuva_leve",
            "chuva_forte",
            "outra"
          ]
        },
        "workers": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "equipment": {
          "type": "string",
          "maxLength": 250
        },
        "notes": {
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "front_ref",
          "date",
          "target",
          "service",
          "phase",
          "state",
          "quantity",
          "quantity_kind",
          "element",
          "workers",
          "equipment",
          "activity",
          "notes",
          "validation",
          "review",
          "status_tech",
          "hold_point",
          "medicao",
          "original_source_ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^rdom-[A-Za-z0-9-]+-[0-9]{2,3}$"
          },
          "front_ref": {
            "type": "string",
            "pattern": "^fr-[A-Za-z0-9-]+$"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "target": {
            "type": "string",
            "pattern": "^(E0[1-9]|FAB|GERAL)$"
          },
          "service": {
            "type": "string",
            "enum": [
              "estacas",
              "bloco",
              "pilar",
              "travessa",
              "longarina",
              "prelaje",
              "tabuleiro",
              "equipamento",
              "canteiro",
              "ambiental",
              "qualidade",
              "seguranca"
            ]
          },
          "phase": {
            "type": "string",
            "enum": [
              "nao_especificada",
              "locacao",
              "perfuracao",
              "camisa_metalica",
              "armadura",
              "formas",
              "concretagem",
              "cura",
              "desforma",
              "protensao",
              "lancamento",
              "inspecao",
              "outra"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "em_andamento",
              "executado",
              "parcial_executado",
              "snapshot",
              "observado",
              "mobilizado",
              "parado"
            ]
          },
          "quantity": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "quantity_kind": {
            "type": "string",
            "enum": [
              "nao_informado",
              "unidades_executadas",
              "total_reportado",
              "ordinal_em_execucao",
              "unidades_em_execucao",
              "unidades_com_etapa_parcial",
              "equipamentos_reportados"
            ]
          },
          "element": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "workers": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "equipment": {
            "type": "string",
            "maxLength": 250
          },
          "activity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "notes": {
            "type": "string",
            "maxLength": 2500
          },
          "validation": {
            "const": "proposto_revisao"
          },
          "review": {
            "const": true
          },
          "status_tech": {
            "const": "nao_avaliado"
          },
          "hold_point": {
            "const": "nao_configurado"
          },
          "medicao": {
            "const": "nao_avaliada"
          },
          "original_source_ref": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "photos": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "caption",
          "record_ref",
          "target",
          "mime_type",
          "size_bytes",
          "sha256",
          "privacy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 8
          },
          "path": {
            "type": "string",
            "pattern": "^anexos/[0-9]{4}-[0-9]{2}/[A-Za-z0-9-]+/foto-[0-9]{2}\\.jpg$"
          },
          "caption": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "record_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "target": {
            "type": "string",
            "pattern": "^(E0[1-9]|FAB|GERAL)$"
          },
          "mime_type": {
            "const": "image/jpeg"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2097152
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "privacy": {
            "const": "privado"
          }
        }
      }
    }
  }
}
